{
  "name": "codechallenge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "react": "19.2.0",
    "react-native": "0.81.4",
    "react-native-camera": "^4.2.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-global-font": "^1.0.3",
    "react-native-keyboard-aware-scrollview": "^2.1.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "^4.1.2",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-slider": "^0.11.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/runtime": "^7.28.4",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "^0.81.1",
    "babel-jest": "^30.2.0",
    "eslint": "8.57.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "react-test-renderer": "19.2.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-gesture-handler|react-native-reanimated|react-native-screens|react-native-safe-area-context|react-native-vector-icons|@react-native-masked-view|react-native-global-font|react-native-paper|react-native-camera|react-native-keyboard-aware-scrollview|react-native-slider)/)"
    ],
    "moduleNameMapper": {
      "\\.(png|jpg|ico|jpeg|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "identity-obj-proxy"
    }
  },
  "rnpm": {
    "assets": [
      "./assets/Fonts"
    ]
  }
}
