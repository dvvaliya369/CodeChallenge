{
  "name": "codechallenge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.3.29",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "^2.24.1",
    "react-native-global-font": "^1.0.3",
    "react-native-keyboard-aware-scrollview": "^2.1.0",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "^3.19.1",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^3.36.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "^0.81.1",
    "@react-native/metro-config": "^0.81.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.19.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|@react-navigation|react-native-global-font|react-native-vector-icons|react-native-reanimated|react-native-gesture-handler|react-native-safe-area-context|react-native-screens|react-native-keyboard-aware-scrollview|react-native-paper|react-native-vision-camera)/)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "identity-obj-proxy"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "rnpm": {
    "assets": [
      "./assets/Fonts"
    ]
  }
}
